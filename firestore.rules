rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function ehDono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /usuarios/{uid} {
      allow read, write: if ehDono(uid);

      match /personagens/{personagemId} {
        allow read, delete: if ehDono(uid);
        allow create, update: if ehDono(uid)
          && request.resource.data.vida is int
          && request.resource.data.vida >= 0;
      }

      match /{subcolecao}/{documento=**} {
        allow read, write: if ehDono(uid) && subcolecao != 'personagens';
      }
    }
  }
}
